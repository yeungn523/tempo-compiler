module {
  tt.func public @gpt2_add_bias(%arg0: !tt.ptr<bf16>, %arg1: !tt.ptr<bf16>, %arg2: !tt.ptr<bf16>) attributes {noinline = false} {
    %c256_i32 = arith.constant 256 : i32
    %c768_i32 = arith.constant 768 : i32
    %cst = arith.constant dense<768> : tensor<32x1xi32>
    %c0_i32 = arith.constant 0 : i32
    %c64_i32 = arith.constant 64 : i32
    %c32_i32 = arith.constant 32 : i32
    scf.for %arg3 = %c0_i32 to %c64_i32 step %c32_i32  : i32 {
      %0 = tt.make_range {end = 32 : i32, start = 0 : i32} : tensor<32xi32>
      %1 = tt.splat %arg3 : i32 -> tensor<32xi32>
      %2 = arith.addi %1, %0 : tensor<32xi32>
      scf.for %arg4 = %c0_i32 to %c768_i32 step %c256_i32  : i32 {
        %3 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32>
        %4 = tt.splat %arg4 : i32 -> tensor<256xi32>
        %5 = arith.addi %4, %3 : tensor<256xi32>
        %6 = tt.expand_dims %2 {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
        %7 = arith.muli %6, %cst : tensor<32x1xi32>
        %8 = tt.expand_dims %5 {axis = 0 : i32} : tensor<256xi32> -> tensor<1x256xi32>
        %9 = tt.broadcast %7 : tensor<32x1xi32> -> tensor<32x256xi32>
        %10 = tt.broadcast %8 : tensor<1x256xi32> -> tensor<32x256xi32>
        %11 = arith.addi %9, %10 : tensor<32x256xi32>
        %12 = tt.splat %arg1 : !tt.ptr<bf16> -> tensor<256x!tt.ptr<bf16>>
        %13 = tt.addptr %12, %5 : tensor<256x!tt.ptr<bf16>>, tensor<256xi32>
        %14 = tt.load %13 : tensor<256x!tt.ptr<bf16>>
        %15 = tt.splat %arg2 : !tt.ptr<bf16> -> tensor<32x256x!tt.ptr<bf16>>
        %16 = tt.addptr %15, %11 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
        %17 = tt.splat %arg0 : !tt.ptr<bf16> -> tensor<32x256x!tt.ptr<bf16>>
        %18 = tt.addptr %17, %11 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
        %19 = tt.load %18 : tensor<32x256x!tt.ptr<bf16>>
        %20 = tt.expand_dims %14 {axis = 0 : i32} : tensor<256xbf16> -> tensor<1x256xbf16>
        %21 = tt.broadcast %20 : tensor<1x256xbf16> -> tensor<32x256xbf16>
        %22 = arith.addf %19, %21 : tensor<32x256xbf16>
        tt.store %16, %22 : tensor<32x256x!tt.ptr<bf16>>
      }
    }
    tt.return
  }
}
