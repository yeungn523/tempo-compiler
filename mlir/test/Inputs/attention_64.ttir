module {
  tt.func public @gpt2_attention(%arg0: !tt.ptr<bf16>, %arg1: !tt.ptr<bf16>, %arg2: !tt.ptr<bf16>, %arg3: !tt.ptr<bf16>) attributes {noinline = false} {
    %cst = arith.constant dense<0xFF800000> : tensor<16xf32>
    %cst_0 = arith.constant dense<0.000000e+00> : tensor<16xf32>
    %c16_i32 = arith.constant 16 : i32
    %c64_i32 = arith.constant 64 : i32
    %c0_i32 = arith.constant 0 : i32
    %cst_1 = arith.constant dense<0.000000e+00> : tensor<16x64xf32>
    %cst_2 = arith.constant dense<-1.000000e+30> : tensor<16x16xf32>
    %cst_3 = arith.constant dense<0.000000e+00> : tensor<16x16xf32>
    %cst_4 = arith.constant dense<64> : tensor<16x1xi32>
    %0 = tt.make_range {end = 64 : i32, start = 0 : i32} : tensor<64xi32>
    scf.for %arg4 = %c0_i32 to %c64_i32 step %c16_i32  : i32 {
      %1 = tt.make_range {end = 16 : i32, start = 0 : i32} : tensor<16xi32>
      %2 = tt.splat %arg4 : i32 -> tensor<16xi32>
      %3 = arith.addi %2, %1 : tensor<16xi32>
      %4 = tt.expand_dims %3 {axis = 1 : i32} : tensor<16xi32> -> tensor<16x1xi32>
      %5 = arith.muli %4, %cst_4 : tensor<16x1xi32>
      %6 = tt.splat %arg0 : !tt.ptr<bf16> -> tensor<16x1x!tt.ptr<bf16>>
      %7 = tt.addptr %6, %5 : tensor<16x1x!tt.ptr<bf16>>, tensor<16x1xi32>
      %8 = tt.expand_dims %0 {axis = 0 : i32} : tensor<64xi32> -> tensor<1x64xi32>
      %9 = tt.broadcast %7 : tensor<16x1x!tt.ptr<bf16>> -> tensor<16x64x!tt.ptr<bf16>>
      %10 = tt.broadcast %8 : tensor<1x64xi32> -> tensor<16x64xi32>
      %11 = tt.addptr %9, %10 : tensor<16x64x!tt.ptr<bf16>>, tensor<16x64xi32>
      %12 = tt.load %11 : tensor<16x64x!tt.ptr<bf16>>
      %13:3 = scf.for %arg5 = %c0_i32 to %c64_i32 step %c16_i32 iter_args(%arg6 = %cst, %arg7 = %cst_0, %arg8 = %cst_1) -> (tensor<16xf32>, tensor<16xf32>, tensor<16x64xf32>)  : i32 {
        %22 = tt.splat %arg5 : i32 -> tensor<16xi32>
        %23 = arith.addi %22, %1 : tensor<16xi32>
        %24 = tt.expand_dims %23 {axis = 1 : i32} : tensor<16xi32> -> tensor<16x1xi32>
        %25 = arith.muli %24, %cst_4 : tensor<16x1xi32>
        %26 = tt.splat %arg1 : !tt.ptr<bf16> -> tensor<16x1x!tt.ptr<bf16>>
        %27 = tt.addptr %26, %25 : tensor<16x1x!tt.ptr<bf16>>, tensor<16x1xi32>
        %28 = tt.broadcast %27 : tensor<16x1x!tt.ptr<bf16>> -> tensor<16x64x!tt.ptr<bf16>>
        %29 = tt.addptr %28, %10 : tensor<16x64x!tt.ptr<bf16>>, tensor<16x64xi32>
        %30 = tt.load %29 : tensor<16x64x!tt.ptr<bf16>>
        %31 = tt.splat %arg2 : !tt.ptr<bf16> -> tensor<16x1x!tt.ptr<bf16>>
        %32 = tt.addptr %31, %25 : tensor<16x1x!tt.ptr<bf16>>, tensor<16x1xi32>
        %33 = tt.broadcast %32 : tensor<16x1x!tt.ptr<bf16>> -> tensor<16x64x!tt.ptr<bf16>>
        %34 = tt.addptr %33, %10 : tensor<16x64x!tt.ptr<bf16>>, tensor<16x64xi32>
        %35 = tt.load %34 : tensor<16x64x!tt.ptr<bf16>>
        %36 = tt.expand_dims %23 {axis = 0 : i32} : tensor<16xi32> -> tensor<1x16xi32>
        %37 = tt.broadcast %4 : tensor<16x1xi32> -> tensor<16x16xi32>
        %38 = tt.broadcast %36 : tensor<1x16xi32> -> tensor<16x16xi32>
        %39 = arith.cmpi sge, %37, %38 : tensor<16x16xi32>
        %40 = tt.trans %30 {order = array<i32: 1, 0>} : tensor<16x64xbf16> -> tensor<64x16xbf16>
        %41 = tt.dot %12, %40, %cst_3 : tensor<16x64xbf16> * tensor<64x16xbf16> -> tensor<16x16xf32>
        %42 = arith.select %39, %41, %cst_2 : tensor<16x16xi1>, tensor<16x16xf32>
        %43 = "tt.reduce"(%42) <{axis = 1 : i32}> ({
        ^bb0(%arg9: f32, %arg10: f32):
          %59 = arith.maxnumf %arg9, %arg10 : f32
          tt.reduce.return %59 : f32
        }) : (tensor<16x16xf32>) -> tensor<16xf32>
        %44 = arith.maxnumf %arg6, %43 : tensor<16xf32>
        %45 = tt.expand_dims %44 {axis = 1 : i32} : tensor<16xf32> -> tensor<16x1xf32>
        %46 = tt.broadcast %45 : tensor<16x1xf32> -> tensor<16x16xf32>
        %47 = arith.subf %42, %46 : tensor<16x16xf32>
        %48 = math.exp %47 : tensor<16x16xf32>
        %49 = arith.subf %arg6, %44 : tensor<16xf32>
        %50 = math.exp %49 : tensor<16xf32>
        %51 = arith.mulf %arg7, %50 : tensor<16xf32>
        %52 = "tt.reduce"(%48) <{axis = 1 : i32}> ({
        ^bb0(%arg9: f32, %arg10: f32):
          %59 = arith.addf %arg9, %arg10 : f32
          tt.reduce.return %59 : f32
        }) : (tensor<16x16xf32>) -> tensor<16xf32>
        %53 = arith.addf %51, %52 : tensor<16xf32>
        %54 = tt.expand_dims %50 {axis = 1 : i32} : tensor<16xf32> -> tensor<16x1xf32>
        %55 = tt.broadcast %54 : tensor<16x1xf32> -> tensor<16x64xf32>
        %56 = arith.mulf %arg8, %55 : tensor<16x64xf32>
        %57 = arith.truncf %48 : tensor<16x16xf32> to tensor<16x16xbf16>
        %58 = tt.dot %57, %35, %56 : tensor<16x16xbf16> * tensor<16x64xbf16> -> tensor<16x64xf32>
        scf.yield %44, %53, %58 : tensor<16xf32>, tensor<16xf32>, tensor<16x64xf32>
      }
      %14 = tt.expand_dims %13#1 {axis = 1 : i32} : tensor<16xf32> -> tensor<16x1xf32>
      %15 = tt.broadcast %14 : tensor<16x1xf32> -> tensor<16x64xf32>
      %16 = arith.divf %13#2, %15 : tensor<16x64xf32>
      %17 = tt.splat %arg3 : !tt.ptr<bf16> -> tensor<16x1x!tt.ptr<bf16>>
      %18 = tt.addptr %17, %5 : tensor<16x1x!tt.ptr<bf16>>, tensor<16x1xi32>
      %19 = tt.broadcast %18 : tensor<16x1x!tt.ptr<bf16>> -> tensor<16x64x!tt.ptr<bf16>>
      %20 = tt.addptr %19, %10 : tensor<16x64x!tt.ptr<bf16>>, tensor<16x64xi32>
      %21 = arith.truncf %16 : tensor<16x64xf32> to tensor<16x64xbf16>
      tt.store %20, %21 : tensor<16x64x!tt.ptr<bf16>>
    }
    tt.return
  }
}
