          %33 = arith.divf %31, %cst_4 : tensor<32x256xf32>
          %34 = math.erf %33 : tensor<32x256xf32>
          %35 = arith.addf %34, %cst_3 : tensor<32x256xf32>
          %36 = arith.mulf %32, %35 : tensor<32x256xf32>
          %37 = arith.truncf %36 : tensor<32x256xf32> to tensor<32x256xbf16>
          %38 = tt.load %arg7 : tensor<256x16x!tt.ptr<bf16>>
          %39 = tt.dot %37, %38, %arg8 : tensor<32x256xbf16> * tensor<256x16xbf16> -> tensor<32x16xf32>
          %40 = tt.addptr %arg6, %cst_1 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
          %41 = tt.addptr %arg7, %cst_0 : tensor<256x16x!tt.ptr<bf16>>, tensor<256x16xi32>
          scf.yield %40, %41, %39 : tensor<32x256x!tt.ptr<bf16>>, tensor<256x16x!tt.ptr<bf16>>, tensor<32x16xf32>
