        %25 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<32x1x!tt.ptr<f32>>
        %26 = tt.addptr %25, %24 : tensor<32x1x!tt.ptr<f32>>, tensor<32x1xi32>
        %27 = tt.broadcast %26 : tensor<32x1x!tt.ptr<f32>> -> tensor<32x16x!tt.ptr<f32>>
        %28 = tt.broadcast %19 : tensor<1x16xi32> -> tensor<32x16xi32>
        %29 = tt.addptr %27, %28 : tensor<32x16x!tt.ptr<f32>>, tensor<32x16xi32>
