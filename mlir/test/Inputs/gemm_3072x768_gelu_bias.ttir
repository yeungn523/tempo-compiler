    %cst_1 = arith.constant dense<256> : tensor<32x256xi32>
    %cst_2 = arith.constant dense<0.000000e+00> : tensor<32x16xf32>
    %cst_3 = arith.constant dense<1.000000e+00> : tensor<32x256xf32>
    %cst_4 = arith.constant dense<1.41421354> : tensor<32x256xf32>
    %cst_5 = arith.constant dense<5.000000e-01> : tensor<32x256xf32>
    %cst_6 = arith.constant dense<768> : tensor<256x1xi32>
    %cst_7 = arith.constant dense<3072> : tensor<32x1xi32>
    %0 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32>
    scf.for %arg4 = %c0_i32 to %c64_i32 step %c32_i32  : i32 {
      %1 = tt.make_range {end = 32 : i32, start = 0 : i32} : tensor<32xi32>
      %2 = tt.splat %arg4 : i32 -> tensor<32xi32>
      %3 = arith.addi %2, %1 : tensor<32xi32>
      scf.for %arg5 = %c0_i32 to %c768_i32 step %c16_i32  : i32 {
        %4 = tt.make_range {end = 16 : i32, start = 0 : i32} : tensor<16xi32>
        %5 = tt.splat %arg5 : i32 -> tensor<16xi32>
        %6 = arith.addi %5, %4 : tensor<16xi32>
        %7 = tt.expand_dims %3 {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
        %8 = arith.muli %7, %cst_7 : tensor<32x1xi32>
        %9 = tt.splat %arg0 : !tt.ptr<bf16> -> tensor<32x1x!tt.ptr<bf16>>
        %10 = tt.addptr %9, %8 : tensor<32x1x!tt.ptr<bf16>>, tensor<32x1xi32>
        %11 = tt.expand_dims %0 {axis = 0 : i32} : tensor<256xi32> -> tensor<1x256xi32>
        %12 = tt.broadcast %10 : tensor<32x1x!tt.ptr<bf16>> -> tensor<32x256x!tt.ptr<bf16>>
        %13 = tt.broadcast %11 : tensor<1x256xi32> -> tensor<32x256xi32>
        %14 = tt.addptr %12, %13 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
        %15 = tt.expand_dims %0 {axis = 1 : i32} : tensor<256xi32> -> tensor<256x1xi32>
        %16 = arith.muli %15, %cst_6 : tensor<256x1xi32>
        %17 = tt.splat %arg1 : !tt.ptr<bf16> -> tensor<256x1x!tt.ptr<bf16>>
        %18 = tt.addptr %17, %16 : tensor<256x1x!tt.ptr<bf16>>, tensor<256x1xi32>
        %19 = tt.expand_dims %6 {axis = 0 : i32} : tensor<16xi32> -> tensor<1x16xi32>
        %20 = tt.broadcast %18 : tensor<256x1x!tt.ptr<bf16>> -> tensor<256x16x!tt.ptr<bf16>>
        %21 = tt.broadcast %19 : tensor<1x16xi32> -> tensor<256x16xi32>
        %22 = tt.addptr %20, %21 : tensor<256x16x!tt.ptr<bf16>>, tensor<256x16xi32>
        %23:3 = scf.for %arg6 = %c0_i32 to %c3072_i32 step %c256_i32 iter_args(%arg7 = %14, %arg8 = %22, %arg9 = %cst_2) -> (tensor<32x256x!tt.ptr<bf16>>, tensor<256x16x!tt.ptr<bf16>>, tensor<32x16xf32>)  : i32 {
          %37 = tt.load %arg7 : tensor<32x256x!tt.ptr<bf16>>
          %38 = arith.extf %37 : tensor<32x256xbf16> to tensor<32x256xf32>
          %39 = arith.mulf %38, %cst_5 : tensor<32x256xf32>
          %40 = arith.divf %38, %cst_4 : tensor<32x256xf32>
          %41 = math.erf %40 : tensor<32x256xf32>
          %42 = arith.addf %41, %cst_3 : tensor<32x256xf32>
          %43 = arith.mulf %39, %42 : tensor<32x256xf32>
          %44 = arith.truncf %43 : tensor<32x256xf32> to tensor<32x256xbf16>
          %45 = tt.load %arg8 : tensor<256x16x!tt.ptr<bf16>>
          %46 = tt.dot %44, %45, %arg9 : tensor<32x256xbf16> * tensor<256x16xbf16> -> tensor<32x16xf32>
          %47 = tt.addptr %arg7, %cst_1 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
          %48 = tt.addptr %arg8, %cst_0 : tensor<256x16x!tt.ptr<bf16>>, tensor<256x16xi32>
          scf.yield %47, %48, %46 : tensor<32x256x!tt.ptr<bf16>>, tensor<256x16x!tt.ptr<bf16>>, tensor<32x16xf32>
        }
        %24 = tt.splat %arg3 : !tt.ptr<bf16> -> tensor<16x!tt.ptr<bf16>>
        %25 = tt.addptr %24, %6 : tensor<16x!tt.ptr<bf16>>, tensor<16xi32>
        %26 = tt.load %25 : tensor<16x!tt.ptr<bf16>>
        %27 = arith.extf %26 : tensor<16xbf16> to tensor<16xf32>
        %28 = arith.muli %7, %cst : tensor<32x1xi32>
        %29 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<32x1x!tt.ptr<f32>>
        %30 = tt.addptr %29, %28 : tensor<32x1x!tt.ptr<f32>>, tensor<32x1xi32>
        %31 = tt.broadcast %30 : tensor<32x1x!tt.ptr<f32>> -> tensor<32x16x!tt.ptr<f32>>
        %32 = tt.broadcast %19 : tensor<1x16xi32> -> tensor<32x16xi32>
        %33 = tt.addptr %31, %32 : tensor<32x16x!tt.ptr<f32>>, tensor<32x16xi32>
        %34 = tt.expand_dims %27 {axis = 0 : i32} : tensor<16xf32> -> tensor<1x16xf32>
        %35 = tt.broadcast %34 : tensor<1x16xf32> -> tensor<32x16xf32>
        %36 = arith.addf %23#2, %35 : tensor<32x16xf32>
