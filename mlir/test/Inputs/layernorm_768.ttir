module {
  tt.func public @gpt2_layernorm(%arg0: !tt.ptr<bf16>, %arg1: !tt.ptr<bf16>, %arg2: !tt.ptr<bf16>, %arg3: !tt.ptr<bf16>) attributes {noinline = false} {
    %cst = arith.constant dense<0.000000e+00> : tensor<32x256xf32>
    %c256_i32 = arith.constant 256 : i32
    %c768_i32 = arith.constant 768 : i32
    %cst_0 = arith.constant dense<9.99999974E-6> : tensor<32xf32>
    %cst_1 = arith.constant dense<7.680000e+02> : tensor<32xf32>
    %cst_2 = arith.constant dense<768> : tensor<32x1xi32>
    %c0_i32 = arith.constant 0 : i32
    %c64_i32 = arith.constant 64 : i32
    %c32_i32 = arith.constant 32 : i32
    scf.for %arg4 = %c0_i32 to %c64_i32 step %c32_i32  : i32 {
      %0 = tt.make_range {end = 32 : i32, start = 0 : i32} : tensor<32xi32>
      %1 = tt.splat %arg4 : i32 -> tensor<32xi32>
      %2 = arith.addi %1, %0 : tensor<32xi32>
      %3 = scf.for %arg5 = %c0_i32 to %c768_i32 step %c256_i32 iter_args(%arg6 = %cst) -> (tensor<32x256xf32>)  : i32 {
        %11 = tt.expand_dims %2 {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
        %12 = arith.muli %11, %cst_2 : tensor<32x1xi32>
        %13 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32>
        %14 = tt.splat %arg5 : i32 -> tensor<256xi32>
        %15 = arith.addi %14, %13 : tensor<256xi32>
        %16 = tt.expand_dims %15 {axis = 0 : i32} : tensor<256xi32> -> tensor<1x256xi32>
        %17 = tt.broadcast %12 : tensor<32x1xi32> -> tensor<32x256xi32>
        %18 = tt.broadcast %16 : tensor<1x256xi32> -> tensor<32x256xi32>
        %19 = arith.addi %17, %18 : tensor<32x256xi32>
        %20 = tt.splat %arg0 : !tt.ptr<bf16> -> tensor<32x256x!tt.ptr<bf16>>
        %21 = tt.addptr %20, %19 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
        %22 = tt.load %21 : tensor<32x256x!tt.ptr<bf16>>
        %23 = arith.extf %22 : tensor<32x256xbf16> to tensor<32x256xf32>
        %24 = arith.addf %arg6, %23 : tensor<32x256xf32>
        scf.yield %24 : tensor<32x256xf32>
      }
      %4 = "tt.reduce"(%3) <{axis = 1 : i32}> ({
      ^bb0(%arg5: f32, %arg6: f32):
        %11 = arith.addf %arg5, %arg6 : f32
        tt.reduce.return %11 : f32
      }) : (tensor<32x256xf32>) -> tensor<32xf32>
      %5 = arith.divf %4, %cst_1 : tensor<32xf32>
      %6 = scf.for %arg5 = %c0_i32 to %c768_i32 step %c256_i32 iter_args(%arg6 = %cst) -> (tensor<32x256xf32>)  : i32 {
        %11 = tt.expand_dims %2 {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
        %12 = arith.muli %11, %cst_2 : tensor<32x1xi32>
        %13 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32>
        %14 = tt.splat %arg5 : i32 -> tensor<256xi32>
        %15 = arith.addi %14, %13 : tensor<256xi32>
        %16 = tt.expand_dims %15 {axis = 0 : i32} : tensor<256xi32> -> tensor<1x256xi32>
        %17 = tt.broadcast %12 : tensor<32x1xi32> -> tensor<32x256xi32>
        %18 = tt.broadcast %16 : tensor<1x256xi32> -> tensor<32x256xi32>
        %19 = arith.addi %17, %18 : tensor<32x256xi32>
        %20 = tt.splat %arg0 : !tt.ptr<bf16> -> tensor<32x256x!tt.ptr<bf16>>
        %21 = tt.addptr %20, %19 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
        %22 = tt.load %21 : tensor<32x256x!tt.ptr<bf16>>
        %23 = arith.extf %22 : tensor<32x256xbf16> to tensor<32x256xf32>
        %24 = tt.expand_dims %5 {axis = 1 : i32} : tensor<32xf32> -> tensor<32x1xf32>
        %25 = tt.broadcast %24 : tensor<32x1xf32> -> tensor<32x256xf32>
        %26 = arith.subf %23, %25 : tensor<32x256xf32>
        %27 = arith.mulf %26, %26 : tensor<32x256xf32>
        %28 = arith.addf %arg6, %27 : tensor<32x256xf32>
        scf.yield %28 : tensor<32x256xf32>
      }
      %7 = "tt.reduce"(%6) <{axis = 1 : i32}> ({
      ^bb0(%arg5: f32, %arg6: f32):
        %11 = arith.addf %arg5, %arg6 : f32
        tt.reduce.return %11 : f32
      }) : (tensor<32x256xf32>) -> tensor<32xf32>
      %8 = arith.divf %7, %cst_1 : tensor<32xf32>
      %9 = arith.addf %8, %cst_0 : tensor<32xf32>
      %10 = math.rsqrt %9 : tensor<32xf32>
      scf.for %arg5 = %c0_i32 to %c768_i32 step %c256_i32  : i32 {
        %11 = tt.make_range {end = 256 : i32, start = 0 : i32} : tensor<256xi32>
        %12 = tt.splat %arg5 : i32 -> tensor<256xi32>
        %13 = arith.addi %12, %11 : tensor<256xi32>
        %14 = tt.expand_dims %2 {axis = 1 : i32} : tensor<32xi32> -> tensor<32x1xi32>
        %15 = arith.muli %14, %cst_2 : tensor<32x1xi32>
        %16 = tt.expand_dims %13 {axis = 0 : i32} : tensor<256xi32> -> tensor<1x256xi32>
        %17 = tt.broadcast %15 : tensor<32x1xi32> -> tensor<32x256xi32>
        %18 = tt.broadcast %16 : tensor<1x256xi32> -> tensor<32x256xi32>
        %19 = arith.addi %17, %18 : tensor<32x256xi32>
        %20 = tt.splat %arg0 : !tt.ptr<bf16> -> tensor<32x256x!tt.ptr<bf16>>
        %21 = tt.addptr %20, %19 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
        %22 = tt.load %21 : tensor<32x256x!tt.ptr<bf16>>
        %23 = arith.extf %22 : tensor<32x256xbf16> to tensor<32x256xf32>
        %24 = tt.expand_dims %5 {axis = 1 : i32} : tensor<32xf32> -> tensor<32x1xf32>
        %25 = tt.broadcast %24 : tensor<32x1xf32> -> tensor<32x256xf32>
        %26 = arith.subf %23, %25 : tensor<32x256xf32>
        %27 = tt.splat %arg1 : !tt.ptr<bf16> -> tensor<256x!tt.ptr<bf16>>
        %28 = tt.addptr %27, %13 : tensor<256x!tt.ptr<bf16>>, tensor<256xi32>
        %29 = tt.load %28 : tensor<256x!tt.ptr<bf16>>
        %30 = arith.extf %29 : tensor<256xbf16> to tensor<256xf32>
        %31 = tt.splat %arg2 : !tt.ptr<bf16> -> tensor<256x!tt.ptr<bf16>>
        %32 = tt.addptr %31, %13 : tensor<256x!tt.ptr<bf16>>, tensor<256xi32>
        %33 = tt.load %32 : tensor<256x!tt.ptr<bf16>>
        %34 = arith.extf %33 : tensor<256xbf16> to tensor<256xf32>
        %35 = tt.expand_dims %10 {axis = 1 : i32} : tensor<32xf32> -> tensor<32x1xf32>
        %36 = tt.broadcast %35 : tensor<32x1xf32> -> tensor<32x256xf32>
        %37 = arith.mulf %26, %36 : tensor<32x256xf32>
        %38 = tt.expand_dims %30 {axis = 0 : i32} : tensor<256xf32> -> tensor<1x256xf32>
        %39 = tt.broadcast %38 : tensor<1x256xf32> -> tensor<32x256xf32>
        %40 = arith.mulf %37, %39 : tensor<32x256xf32>
        %41 = tt.expand_dims %34 {axis = 0 : i32} : tensor<256xf32> -> tensor<1x256xf32>
        %42 = tt.broadcast %41 : tensor<1x256xf32> -> tensor<32x256xf32>
        %43 = arith.addf %40, %42 : tensor<32x256xf32>
        %44 = tt.splat %arg3 : !tt.ptr<bf16> -> tensor<32x256x!tt.ptr<bf16>>
        %45 = tt.addptr %44, %19 : tensor<32x256x!tt.ptr<bf16>>, tensor<32x256xi32>
        %46 = arith.truncf %43 : tensor<32x256xf32> to tensor<32x256xbf16>
        tt.store %45, %46 : tensor<32x256x!tt.ptr<bf16>>
      }
    }
    tt.return
  }
}
